<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="538.0" prefWidth="431.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.recepcion_de_cafe.RecepcionController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Recepcion de Cafe">
      <font>
         <Font size="20.0" />
      </font></Label>
   <TextField fx:id="txtCodigo" promptText="Codigo" />
   <TextField fx:id="txtProductor" promptText="Productor" />
   <TextField fx:id="txtQuintales" promptText="Quintales" />
   <TextField fx:id="txtPrecio" promptText="Precio por quintal" />
   <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="90.0">
      <children>
         <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#agregarLote" text="Agregar" />
         <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarCambios" text="Guardar Cambios" />
      </children>
   </HBox>
   <Label fx:id="lblDetalle" text="Detalle del Lote">
      <font>
         <Font size="15.0" />
      </font>
   </Label>
   <TableView fx:id="tvLotes" onMouseClicked="#mostrarDetalle" prefHeight="200.0" prefWidth="200.0">
     <columns>
       <TableColumn fx:id="colCodigo" prefWidth="75.0" text="Codigo" />
       <TableColumn fx:id="colProductor" prefWidth="75.0" text="Productor" />
         <TableColumn fx:id="colQuintales" prefWidth="75.0" text="Quintales" />
         <TableColumn fx:id="colPrecio" prefWidth="75.0" text="Precio/quintal" />
     </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
       <contextMenu>
           <ContextMenu>
               <items>
                   <MenuItem mnemonicParsing="false" onAction="#editarLote" text="Editar" />
                   <MenuItem mnemonicParsing="false" onAction="#eliminarLote" text="Eliminar" />
               </items>
           </ContextMenu>
       </contextMenu>
   </TableView>
</VBox>
