<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="562.0" prefWidth="572.0" spacing="20.0" style="-fx-background-color: pink;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.tiendaartesanias.TiendaController">
  <padding>
    <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
  </padding>
   <children>
      <MenuBar style="-fx-background-color: #b4b1b1;">
        <menus>
          <Menu mnemonicParsing="false" text="Catalogo">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#verCatalogo" text="Ver Catalogo" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Ventas">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#registrarVenta" text="Registrar Ventas" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Ayuda">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#acercaDe" text="Acerca de" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <Label text="Tienda de Artesanias">
         <font>
            <Font name="Cambria" size="15.0" />
         </font></Label>
      <ImageView fitHeight="69.0" fitWidth="121.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@artesanias.png" />
         </image></ImageView>
      <ToolBar prefHeight="0.0" prefWidth="321.0" style="-fx-background-color: #b4b1b1;">
        <items>
          <Button fx:id="btnNuevo" mnemonicParsing="false" onAction="#nuevoProducto" text="Nuevo" />
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarProducto" text="Guardar" />
            <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarProducto" text="Buscar" />
        </items>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
         <VBox.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" />
         </VBox.margin>
      </ToolBar>
      <HBox alignment="TOP_CENTER" prefHeight="77.0" prefWidth="336.0">
         <children>
            <VBox alignment="CENTER" prefHeight="97.0" prefWidth="141.0" spacing="10.0">
               <children>
                  <TextField fx:id="txtNombre" promptText="Nombre" />
                  <TextField fx:id="txtCategoria" promptText="Categoria" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <VBox alignment="CENTER" layoutX="108.0" layoutY="10.0" prefHeight="97.0" prefWidth="141.0" spacing="10.0">
               <children>
                  <TextField fx:id="txtPrecio" promptText="Precio" />
                  <TextField fx:id="txtStock" promptText="Stock" />
                  <TextField fx:id="txtImagen" promptText="Imagen (.png)" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
                       </children>
      </HBox>
      <TableView fx:id="tvCatalogo" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #b4b1b1;">
        <columns>
          <TableColumn fx:id="colImagen" prefWidth="75.0" text="Imagen" />
          <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="colCategoria" prefWidth="75.0" text="Categoria" />
            <TableColumn fx:id="colPrecio" prefWidth="75.0" text="Precio (C$)" />
            <TableColumn fx:id="colStock" prefWidth="75.0" text="Stock" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
